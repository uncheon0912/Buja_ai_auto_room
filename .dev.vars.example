# 로컬 실행 및 순찰 스크립트에서 쓰는 설정 예시 파일입니다.
# 이 파일을 복사해 [.dev.vars] 로 저장한 뒤 실제 값을 입력하세요. (.dev.vars 는 GitHub에 올라가지 않습니다)

# 1) 회의실 주소 및 입장 키
ROOM_BASE=https://buja-ai-room.pages.dev
ROOM_KEY=change-me-room-passcode
API_KEY=change-me-long-random-api-key

# 2) 클라우드 AI API 키 (지피고 · 안티고/홍보부/CS/비서실 순찰용)
OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-key

# 3) 로컬 오프라인 Ollama 모델 선택 (기본: qwen2.5:7b / 추천: exaone3.5:7.8b 또는 deepseek-r1:8b)
OLLAMA_MODEL=qwen2.5:7b
